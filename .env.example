# Access key from https://web3forms.com — enter ktp.northeastern@gmail.com there
# and they email the key. The contact form posts to Web3Forms from the browser,
# which then forwards the submission to that address.
#
# NEXT_PUBLIC_ because Web3Forms requires the request to come from the browser
# (their endpoint's Cloudflare challenge rejects server-to-server posts). These
# keys are public by design and don't expose the inbox address they route to.
# Copy this file to .env.local and paste the real key in.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
